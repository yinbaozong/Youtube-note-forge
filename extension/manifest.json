{
  "manifest_version": 3,
  "name": "YouTube 阅读器",
  "version": "4.1.1",
  "description": "把当前 YouTube 视频交给 Obsidian 的 YouTube Note Reader 插件生成学习笔记。",
  "key": "",
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "host_permissions": ["https://*.youtube.com/*", "https://youtu.be/*", "http://127.0.0.1:32191/*"],
  "background": {"service_worker": "service_worker.js"},
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "生成 YouTube 学习笔记",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
